{
  "type": "function",
  "function": {
    "name": "observation.detail",
    "description": "展开历史摘要的详细记录。必填 observationId：从 #observation 对应项原样取得的 id。返回该摘要对应的完整历史记录，找不到时返回缺失提示；不会重新观察当前页面。affectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        },
        "observationId": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "observationId"
      ]
    }
  }
}
