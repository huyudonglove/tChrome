{
  "type": "function",
  "function": {
    "name": "notes.write",
    "description": "写入或覆盖 ledger.notes[key]。入参：key、value。返回：当前该项 affectsPage=false。\n适用时机：需要保存或更新一项工作笔记时。必填 key、value，均为字符串。创建或覆盖 #notes[key]，同一个 key 不会追加多份。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "key",
        "value"
      ]
    }
  }
}
