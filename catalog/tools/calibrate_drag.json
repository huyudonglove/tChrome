{
  "type": "function",
  "function": {
    "name": "calibrate_drag",
    "description": "按最近一次 screenshot 的图像坐标拖动。入参：point1/point2=截图像素坐标，image_size=[宽,高]，可选 viewport、tab。返回：ok、mapped_from、mapped_to。先截图，把滑块和缺口点在图上，再调用本工具 affectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "point1": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "截图上的起点像素坐标"
        },
        "point2": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "截图上的终点像素坐标"
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "x2": {
          "type": "number"
        },
        "y2": {
          "type": "number"
        },
        "image_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "最近一次 screenshot 返回的 image_size"
        },
        "viewport": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "最近一次 screenshot 返回的 viewport；缺省时执行器现读"
        },
        "tab": {
          "type": "number"
        },
        "tabId": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
