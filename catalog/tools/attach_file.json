{
  "type": "function",
  "function": {
    "name": "attach_file",
    "description": "给文件选择框指定文件。入参：可选 tab。返回：ok 或 error affectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
