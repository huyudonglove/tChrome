{
  "type": "function",
  "function": {
    "name": "type",
    "description": "在当前焦点或匹配 text 的输入框里输入文字。入参：text，可选 ref、target、tab。返回：ok affectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "description": "snapshot_page 返回的输入框 ref；有 ref 时优先使用"
        },
        "target": {
          "type": "string",
          "description": "没有 ref 时按 name/placeholder/aria-label/label 文字定位"
        },
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "text"
      ]
    }
  }
}
