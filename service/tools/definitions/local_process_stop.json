{
  "type": "function",
  "function": {
    "name": "local_process_stop",
    "description": "终止本会话指定进程及其进程组。返回进程状态。",
    "parameters": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "string",
          "description": "目标本地进程编号，来自 local_run 或 local_process_start 的返回"
        },
        "reason": {
          "type": "string",
          "description": "本次操作的目的"
        }
      },
      "required": [
        "processId",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
