{
  "type": "function",
  "function": {
    "name": "catalog.add",
    "description": "加载缺少的动态工具，names 为工具名数组。\n返回补充的工具名。新增工具须在下一次请求收到其 schema 后调用，不与加载操作放在同一批；后续以当前 tools[] 为准。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false,
          "description": "可省略；加载工具不操作页面，传入时只能为false"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reason",
        "names"
      ]
    }
  }
}
