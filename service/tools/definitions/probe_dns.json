{
  "type": "function",
  "function": {
    "name": "probe_dns",
    "description": "解析域名地址。\n参数：host（域名） 或 url（网址）。\n返回：ok、addresses（解析地址）。\n执行调度：parallel（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "port": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ]
    }
  },
  "execution": "parallel"
}
