{
  "type": "function",
  "function": {
    "name": "switch_tab",
    "description": "切到指定标签并读页。\n参数：tab（目标标签编号），也可传 tabId（目标标签编号）。\n返回：ok、title（页面标题）、url（页面地址）、text（返回文本）。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number",
          "description": "标签 id，也可传 tabId"
        },
        "tabId": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
