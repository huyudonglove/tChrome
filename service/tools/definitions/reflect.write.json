{
  "type": "function",
  "function": {
    "name": "reflect.write",
    "description": "记录当前 turn 的总结与反思（做了什么、依据、风险与下一步）。每次写入分配 rf_ 编号并追加到本轮列表；传 id 时更新该条。正文进入 <reflection> 并随该轮进入压缩材料。\n参数：必填 text；可选 focus、id。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "反思正文"
        },
        "focus": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "可选关注点，如 证据 / 风险 / 下一步"
        },
        "id": {
          "type": "string",
          "pattern": "^rf_[0-9]{2,}$",
          "description": "可选；更新本轮已有反思时填写 rf_ 编号"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
