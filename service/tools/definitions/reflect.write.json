{
  "type": "function",
  "function": {
    "name": "reflect.write",
    "description": "记录当前 turn 的总结与反思（做了什么、依据、风险与下一步）。收口前建议调用，非强制；同轮再次调用会覆盖本轮反思。正文进入 <reflection> 并随该轮进入压缩材料。\n参数：必填 text；可选 focus（反思关注点）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "本轮总结与反思正文"
        },
        "focus": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "可选关注点，如 证据 / 风险 / 下一步"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
