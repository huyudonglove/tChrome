{
  "type": "function",
  "function": {
    "name": "send_http",
    "description": "向完整 HTTP/HTTPS URL 发送一次请求，跟随重定向；method 默认 GET。请求可能修改远端数据。\n返回：ok、status、url（最终地址）、text（最多 8000 字符）。",
    "parameters": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s/?#]+(?:[/?#][^\\s]*)?$",
          "description": "完整 HTTP/HTTPS URL，包含协议和主机名。"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ],
          "description": "HTTP 请求方法，省略时为 GET。GET/HEAD 不携带 body。"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "请求头名称到文本值的映射，例如 {\"Content-Type\":\"application/json\"}。"
        },
        "body": {
          "type": "string",
          "description": "请求正文文本；发送 JSON 时传序列化后的 JSON 字符串，并设置 Content-Type。"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "url",
        "reason",
        "affectsPage"
      ],
      "additionalProperties": false
    }
  }
}
