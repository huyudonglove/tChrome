{
  "type": "function",
  "function": {
    "name": "video_record",
    "description": "持续按帧录制视口（start/stop/status）。\n参数：action=start|stop|status；必填 tabId；start 可配 fps（1-5，默认2）、maxFrames（1-60，默认30）。\nstop 返回 frames 数组；超长走统一门禁。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "stop",
            "status"
          ],
          "description": "操作类型：start 开始录制、stop 停止并返回帧、status 查看状态。"
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "每秒帧数，1-5，默认 2。"
        },
        "maxFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "最多录制帧数，1-60，默认 30。"
        }
      },
      "required": [
        "reason",
        "tabId",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
