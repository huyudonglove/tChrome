{
  "type": "function",
  "function": {
    "name": "clipboard.page_read",
    "description": "读取页面剪贴板文本（navigator.clipboard.readText）。常需页面权限/用户手势，失败时返回原因。\n执行调度：parallel（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
