{
  "type": "function",
  "function": {
    "name": "select",
    "description": "在下拉里选一项。\n参数：value（值） 或 text（文本），可选 tab（目标标签编号）。\n返回：ok、value（当前值）；找不到匹配项失败。",
    "parameters": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "要选中的值或文字"
        },
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
