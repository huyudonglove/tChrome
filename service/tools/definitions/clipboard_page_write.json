{
  "type": "function",
  "function": {
    "name": "clipboard_page_write",
    "description": "向页面剪贴板写入文本（经扩展 offscreen 文档，不要求页面聚焦）。返回 ok 与 bytes（写入文本长度）；失败时 ok=false 并附 error。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "text": {
          "type": "string",
          "description": "要写入剪贴板的文本"
        }
      },
      "required": [
        "reason",
        "tabId",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
