{
  "type": "function",
  "function": {
    "name": "capture_som",
    "description": "捕获视口 Set-of-Marks 标注图，返回 marks；可按 roles 限定可访问角色。必填 tabId。返回 ok、mode、image。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "maxMarks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80,
          "description": "最多标注数量，默认 40"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "只标注这些可访问角色，如 button/link/textbox"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  }
}
