{
  "type": "function",
  "function": {
    "name": "update_window",
    "description": "改变指定窗口状态。\n参数：必填 windowId；可选 state（窗口状态，省略时 normal）。\n返回：ok。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "windowId": {
          "type": "integer",
          "description": "目标窗口编号，从 <openTabs> 或 list_windows 返回取得。"
        },
        "state": {
          "type": "string",
          "enum": [
            "normal",
            "minimized",
            "maximized",
            "fullscreen"
          ],
          "description": "窗口状态。"
        }
      },
      "required": [
        "reason",
        "windowId"
      ],
      "additionalProperties": true
    }
  },
  "execution": "serial"
}
