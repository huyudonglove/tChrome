{
  "type": "function",
  "function": {
    "name": "network_throttle",
    "description": "模拟网络条件。\n参数：profile=offline|slow-3g|fast-3g|4g|online（默认 online）；必填 tabId。\n返回：ok、profile 与生效配置。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号；从 <openTabs> 或工具返回取得。"
        },
        "profile": {
          "type": "string",
          "enum": [
            "offline",
            "slow-3g",
            "fast-3g",
            "4g",
            "online"
          ]
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
