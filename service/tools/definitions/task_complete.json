{
  "type": "function",
  "function": {
    "name": "task_complete",
    "description": "按显式 taskId 确认任务完成。全部 items 必须为 done；仍有 todo/doing 则失败。返回完整最终 task，供完成位置保留。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "taskId": {
          "type": "string",
          "description": "需要更新的任务 ID"
        }
      },
      "required": [
        "reason",
        "taskId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
