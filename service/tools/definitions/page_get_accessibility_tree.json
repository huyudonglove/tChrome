{
  "type": "function",
  "function": {
    "name": "page_get_accessibility_tree",
    "description": "取区域或元素的无障碍树。\n参数：id（页面工具返回的目标标识），必填 tabId（目标标签编号）。\n返回：ok、tree（无障碍树）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "frameId": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "id",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
