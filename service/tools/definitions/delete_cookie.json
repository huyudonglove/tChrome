{
  "type": "function",
  "function": {
    "name": "delete_cookie",
    "description": "删除指定 Cookie。\n参数：必填 name；可选 url、domain、path。\n返回：ok、deleted。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Cookie 名称"
        },
        "url": {
          "type": "string",
          "description": "删除 cookie 的站点 URL"
        },
        "domain": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Cookie 的 path 属性，省略表示默认路径"
        }
      },
      "required": [
        "reason",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
