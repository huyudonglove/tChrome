{
  "type": "function",
  "function": {
    "name": "local.process_stop",
    "description": "终止本会话指定进程及其进程组。返回进程状态。\n本机操作，affectsPage=false；这不表示没有文件或系统副作用。",
    "parameters": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "本次操作的目的"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "processId",
        "reason",
        "affectsPage"
      ],
      "additionalProperties": false
    }
  }
}
