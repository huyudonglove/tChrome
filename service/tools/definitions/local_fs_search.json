{
  "type": "function",
  "function": {
    "name": "local_fs_search",
    "description": "在目录内递归按名称子串 query 搜索文件名，不跟随符号链接，不搜索文件内容。一次最多 8 个目标，items 语义与 local_fs_read 一致（每项 path + 可选 limit/maxEntries；本工具无 maxChars，返回路径列表不消耗内容预算）。\nitems 每项：path（绝对目录）、query（非空子串），可选 limit（默认 100，1..1000）、maxEntries（默认 10000，1..100000）。\n返回 results[]，每项含 ok、path、matches、scanned、truncated、errors；逐项 ok，失败项带 faultCode/error。截断时缩小目录或收紧 query。",
    "parameters": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "一次最多 8 个搜索目标",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "绝对路径（目录）"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "文件名子串"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "default": 100,
                "description": "最大匹配条数"
              },
              "maxEntries": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000,
                "default": 10000,
                "description": "最多扫描目录项"
              }
            },
            "required": [
              "path",
              "query"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "items",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
