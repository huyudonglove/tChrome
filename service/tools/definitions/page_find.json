{
  "type": "function",
  "function": {
    "name": "page_find",
    "description": "页面内搜索（Ctrl+F）。\n参数：query（搜索词）。\n返回：ok（是否成功）、found（是否找到）、text（返回文本）、rect。\naffectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
