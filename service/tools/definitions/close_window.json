{
  "type": "function",
  "function": {
    "name": "close_window",
    "description": "关闭指定窗口。\n参数：必填 windowId。\n返回：ok。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        },
        "windowId": {
          "type": "integer",
          "description": "目标窗口编号，从 <openTabs> 或 list_windows 返回取得。"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "windowId"
      ],
      "additionalProperties": true
    }
  }
}
