{
  "type": "function",
  "function": {
    "name": "close_window",
    "description": "关闭指定窗口。\n参数：必填 windowId。\n返回：ok。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "windowId": {
          "type": "integer",
          "description": "目标窗口编号（从 tabs_current / list_windows 取得）。"
        }
      },
      "required": [
        "reason",
        "windowId"
      ],
      "additionalProperties": true
    }
  },
  "execution": "serial"
}
