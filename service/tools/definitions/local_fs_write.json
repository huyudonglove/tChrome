{
  "type": "function",
  "function": {
    "name": "local_fs_write",
    "description": "写入UTF-8文本文件，默认替换整个文件内容，append=true则追加。父目录必须已存在。返回写入字节数。",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "绝对路径"
        },
        "content": {
          "type": "string",
          "description": "要写入的完整文本内容"
        },
        "append": {
          "type": "boolean",
          "description": "true 时追加到文件末尾，默认替换整个文件"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "content",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
