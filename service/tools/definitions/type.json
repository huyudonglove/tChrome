{
  "type": "function",
  "function": {
    "name": "type",
    "description": "向指定可编辑控件输入 text。必须提供 ref（e_ 编号）或非空 target；不会默认选择当前焦点。ref 失效不回退按文字定位；target 多项匹配时明确失败。返回：ok、value。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "description": "page.* 或 snapshot 返回的 e_ 编号",
          "pattern": "^(?:e|r)_[0-9]{2,}$"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号；从 <openTabs> 或工具返回取得。"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text",
        "tabId"
      ],
      "anyOf": [
        {
          "required": [
            "ref"
          ],
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "description": "page.* 或 snapshot 返回的 e_ 编号",
              "pattern": "^(?:e|r)_[0-9]{2,}$"
            }
          }
        },
        {
          "required": [
            "target"
          ],
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
