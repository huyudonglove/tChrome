{
  "type": "function",
  "function": {
    "name": "type",
    "description": "向指定可编辑控件输入 text。必须提供 ref 或非空 target；不会默认选择当前焦点。ref 来自 snapshot_page 或 find_on_page，不可混用 page.* 的 id。ref 失效不回退按文字定位；target 多项匹配时明确失败。返回：ok、value。",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "description": "参数含义见工具说明。",
          "pattern": "^el_[0-9]{2,}$"
        },
        "target": {
          "type": "string",
          "description": "参数含义见工具说明。",
          "minLength": 1
        },
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "text"
      ],
      "anyOf": [
        {
          "required": [
            "ref"
          ],
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "description": "参数含义见工具说明。",
              "pattern": "^el_[0-9]{2,}$"
            }
          }
        },
        {
          "required": [
            "target"
          ],
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "description": "参数含义见工具说明。",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
