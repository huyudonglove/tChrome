{
  "type": "function",
  "function": {
    "name": "group_tabs",
    "description": "把指定标签编成一组。\n参数：必填 tabIds（标签编号列表）。\n返回：ok、groupId（分组编号）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        },
        "tabIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "description": "要操作的标签编号列表。"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "tabIds"
      ],
      "additionalProperties": true
    }
  }
}
