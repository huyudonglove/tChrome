{
  "type": "function",
  "function": {
    "name": "local.fs_read",
    "description": "按字节分页读取 UTF-8 文本文件，一次最多 8 个目标。items 每项含 path（绝对路径）及可选 offset（默认 0）、limit（默认 65536，范围 4..1048576）。返回 results[]，每项 content、size、nextOffset、truncated；后续页用该项 nextOffset，保持 UTF-8 字符完整；不用于二进制。逐项 ok，失败项带 faultCode/error。\n执行调度：parallel（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "一次最多 8 个读取目标",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "绝对路径"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "default": 0
              },
              "limit": {
                "type": "integer",
                "minimum": 4,
                "maximum": 1048576,
                "default": 65536
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "items",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
