{
  "type": "function",
  "function": {
    "name": "scroll",
    "description": "滚动指定页。\n参数：可选 amount（滚动像素数，负数向上）；必填 tabId（目标标签编号）。\n返回：ok。",
    "parameters": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "description": "像素，负数向上"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
