{
  "type": "function",
  "function": {
    "name": "fingerprint.read",
    "description": "读取当前页面可见的浏览器指纹/环境信息：UA、语言、时区、屏幕、viewport、hardwareConcurrency 等。\n执行调度：parallel（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
