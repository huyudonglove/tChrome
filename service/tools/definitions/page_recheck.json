{
  "type": "function",
  "function": {
    "name": "page_recheck",
    "description": "轻量只读复验（不作为断言）。条件：text / urlContains / titleContains / id / selector / role±name±states。states 见 wait（enabled/checked/selected/expanded/invalid…）。多匹配 role/name 且未给 matchIndex 时不通过。成功验收用 page_assert。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer"
        },
        "frameId": {
          "type": "integer",
          "description": "内嵌文档编号，从 frame_list 取得；不传则作用于主文档。"
        },
        "id": {
          "type": "string",
          "description": "page.* 返回的 e_/r_ 编号（元素或区域），原样传入。"
        },
        "selector": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "目标文字：作为定位条件时的可见文本或可访问名子串"
        },
        "urlContains": {
          "type": "string",
          "description": "响应 URL 需包含的子串"
        },
        "titleContains": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "可访问角色，例如 button / link / textbox / navigation；配合 name 使用。"
        },
        "name": {
          "type": "string",
          "description": "可访问名子串，与 role 搭配"
        },
        "states": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "checked": {
              "type": "boolean"
            },
            "selected": {
              "type": "boolean"
            },
            "expanded": {
              "type": "boolean"
            },
            "invalid": {
              "type": "boolean"
            },
            "attached": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "matchIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "多匹配时的命中序号（0 起），不传则不猜测"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
