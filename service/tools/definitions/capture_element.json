{
  "type": "function",
  "function": {
    "name": "capture_element",
    "description": "按页面元素 ref 或唯一 CSS selector 裁剪截图；ref 与 selector 必须且只能提供一个。必填 tabId。返回 ok、mode、image。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "ref": {
          "type": "string",
          "pattern": "^(?:e|r)_[0-9]{2,}$",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^(?:e|r)_[0-9]{2,}$",
              "minLength": 1
            },
            "selector": false
          }
        },
        {
          "type": "object",
          "required": [
            "selector"
          ],
          "properties": {
            "ref": false,
            "selector": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
