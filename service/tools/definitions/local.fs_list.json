{
  "type": "function",
  "function": {
    "name": "local.fs_list",
    "description": "列出目录直接子项。limit默认200最大1000。返回entries（name/path/type）和truncated；目录过大时可用 local.fs_search缩小范围。\n执行调度：parallel（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "绝对路径"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 200
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
