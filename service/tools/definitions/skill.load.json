{
  "type": "function",
  "function": {
    "name": "skill.load",
    "description": "按 id 加载技能正文到本轮 <skill>，会话内保持。id 与 tags 见 skill.list。\n参数：必填 id。\n返回：ok、id、tags、purpose。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" },
        "affectsPage": { "type": "boolean", "const": false },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "技能目录名，如 web-observation"
        }
      },
      "required": ["reason", "affectsPage", "id"],
      "additionalProperties": false
    }
  }
}
