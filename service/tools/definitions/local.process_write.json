{
  "type": "function",
  "function": {
    "name": "local.process_write",
    "description": "向本会话运行中进程的标准输入写入 text；end=true 表示写入后关闭标准输入。返回当前进程快照。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "end": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "description": "本次操作的目的"
        }
      },
      "required": [
        "processId",
        "text",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
