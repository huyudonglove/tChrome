{
  "type": "function",
  "function": {
    "name": "fingerprint_apply",
    "description": "用 CDP 覆盖当前标签的指纹相关环境（模拟，不影响真实磁盘配置）。\n可选：userAgent、platform、acceptLanguage、timezone、locale、width/height/deviceScaleFactor/mobile。\n返回：ok、applied。仅影响该调试会话。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "userAgent": {
          "type": "string",
          "description": "要覆盖的 User-Agent。"
        },
        "platform": {
          "type": "string",
          "description": "要覆盖的 navigator.platform。"
        },
        "acceptLanguage": {
          "type": "string",
          "description": "要覆盖的 Accept-Language 与 navigator.languages。"
        },
        "timezone": {
          "type": "string",
          "description": "要覆盖的时区。"
        },
        "locale": {
          "type": "string",
          "description": "要覆盖的区域设置。"
        },
        "width": {
          "type": "integer",
          "description": "视口宽度。"
        },
        "height": {
          "type": "integer",
          "description": "视口高度。"
        },
        "deviceScaleFactor": {
          "type": "number",
          "description": "设备像素比。"
        },
        "mobile": {
          "type": "boolean",
          "description": "是否模拟移动端。"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
