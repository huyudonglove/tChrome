{
  "type": "function",
  "function": {
    "name": "open_url",
    "description": "打开指定网址并读回标题正文。\n参数：url（网址），可选 tab（目标标签编号）。\n返回：ok、title（页面标题）、url（页面地址）、text（返回文本）、tab。",
    "parameters": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "url"
      ]
    }
  }
}
