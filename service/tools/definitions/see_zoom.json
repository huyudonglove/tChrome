{
  "type": "function",
  "function": {
    "name": "see_zoom",
    "description": "读指定页缩放。\n参数：必填 tabId（目标标签编号）。\n返回：ok、zoom（缩放比例）。",
    "parameters": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs_current 等返回取得，不随前台切换）。"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": true
    }
  },
  "execution": "parallel"
}
