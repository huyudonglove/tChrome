{
  "type": "function",
  "function": {
    "name": "fingerprint.apply",
    "description": "用 CDP 覆盖当前标签的指纹相关环境（模拟，不影响真实磁盘配置）。\n可选：userAgent、platform、acceptLanguage、timezone、locale、width/height/deviceScaleFactor/mobile。\n返回：ok、applied。仅影响该调试会话。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer"
        },
        "userAgent": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "acceptLanguage": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "deviceScaleFactor": {
          "type": "number"
        },
        "mobile": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
