{
  "type": "function",
  "function": {
    "name": "list_browser_tools",
    "description": "列出尚未加载的动态工具。\n返回：ok（是否成功）、tools（工具名列表）；选定所需工具后用 catalog.add 加载。\naffectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
