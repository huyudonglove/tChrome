{
  "type": "function",
  "function": {
    "name": "emulate_device",
    "description": "模拟设备视口与 UA。\n参数：可选 device 预设名，或 width/height/deviceScaleFactor/mobile/userAgent；必填 tabId。\n返回：ok、device、width、height。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" },
        "affectsPage": { "type": "boolean", "const": true },
        "tabId": { "type": "integer", "description": "目标标签编号；从 <openTabs> 或工具返回取得。" },
        "device": { "type": "string", "description": "设备预设名，未知名称时回退桌面配置" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "deviceScaleFactor": { "type": "number" },
        "mobile": { "type": "boolean" },
        "userAgent": { "type": "string" }
      },
      "required": ["reason", "affectsPage", "tabId"],
      "additionalProperties": false
    }
  }
}
