{
  "type": "function",
  "function": {
    "name": "wait",
    "description": "等到出现某段文字或过一段时间。\n参数：可选 text（文本）、ms（等待毫秒数）、tab（目标标签编号）。\n返回：ok（是否成功）、title（页面标题）、url（页面地址）、text（返回文本）。\naffectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "ms": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
