{
  "type": "function",
  "function": {
    "name": "wait",
    "description": "等待条件满足。三种定位：id/selector（可选 visible/enabled）；text（页面出现文字）；role±name±states（A11y，动态加载优先）。states 示例：{enabled:true}、{checked:true}、{expanded:false}、{attached:true}。多匹配 role/name 时返回 ambiguous_target，须收窄或 matchIndex。必填 tabId；ms 默认约 8 秒、上限 12 秒。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号；从 <openTabs> 或工具返回取得。"
        },
        "id": {
          "type": "string",
          "description": "page.* 编号 e_/r_"
        },
        "selector": {
          "type": "string",
          "description": "CSS 选择器，可替代 id"
        },
        "text": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "可访问角色，如 button / alert / dialog / checkbox"
        },
        "name": {
          "type": "string",
          "description": "可访问名子串，与 role 搭配"
        },
        "states": {
          "type": "object",
          "description": "等待 A11y 状态，如 enabled/checked/selected/expanded/invalid/attached",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "checked": {
              "type": "boolean"
            },
            "selected": {
              "type": "boolean"
            },
            "expanded": {
              "type": "boolean"
            },
            "invalid": {
              "type": "boolean"
            },
            "attached": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "matchIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "多匹配时必填，0 起"
        },
        "visible": {
          "type": "boolean",
          "description": "对 id/selector：要求元素可见"
        },
        "enabled": {
          "type": "boolean",
          "description": "对 id/selector：要求非 disabled（角色等待请用 states.enabled）"
        },
        "ms": {
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
