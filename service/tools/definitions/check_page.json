{
  "type": "function",
  "function": {
    "name": "check_page",
    "description": "核对当前页地址、标题或正文是否符合预期。\n参数：可选 text（文本）/url（网址）/title、tab（目标标签编号）。\n返回：ok、matched（是否符合预期）。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
