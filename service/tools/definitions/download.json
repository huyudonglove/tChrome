{
  "type": "function",
  "function": {
    "name": "download",
    "description": "按网址下载文件。\n参数：必填 url（绝对网址）。\n返回：ok、downloadId（下载编号）。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "要下载的绝对网址"
        }
      },
      "required": [
        "reason",
        "url"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
