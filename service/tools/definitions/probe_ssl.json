{
  "type": "function",
  "function": {
    "name": "probe_ssl",
    "description": "查看证书是否有效。\n参数：host（域名） 或 url（网址），可选 port（端口）。\n返回：ok、valid（证书是否有效）、issuer、validTo。",
    "parameters": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "要检测的 URL 或主机名"
        },
        "port": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "parallel"
}
