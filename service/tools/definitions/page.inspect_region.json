{
  "type": "function",
  "function": {
    "name": "page.inspect_region",
    "description": "看一个区域的正文和内部元素。\n参数：id（页面工具返回的 r_01 格式区域标识），可选 tab（目标标签编号）。\n返回：ok、region、elements、text（返回文本）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        },
        "tab": {
          "type": "number"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "id"
      ]
    }
  }
}
