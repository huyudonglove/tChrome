{
  "type": "function",
  "function": {
    "name": "page_storage",
    "description": "读写页内 localStorage。\n参数：action=read|write|delete|list；write/delete 需 key，write 需 value。必填 tabId。\n返回：ok、storage。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（从 tabs_current 等返回取得）。"
        },
        "action": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "delete",
            "list"
          ]
        },
        "key": {
          "type": "string",
          "description": "键名"
        },
        "value": {
          "type": "string",
          "description": "要写入的值"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
