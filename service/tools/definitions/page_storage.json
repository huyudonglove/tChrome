{
  "type": "function",
  "function": {
    "name": "page_storage",
    "description": "读写页内 localStorage。\n参数：action=read|write|delete|list；write/delete 需 key，write 需 value。必填 tabId。\n返回：ok、storage。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" },
        "affectsPage": { "type": "boolean" },
        "tabId": { "type": "integer", "description": "目标标签编号；从 <openTabs> 或工具返回取得。" },
        "action": { "type": "string", "enum": ["read", "write", "delete", "list"] },
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["reason", "affectsPage", "tabId"],
      "additionalProperties": false
    }
  }
}
