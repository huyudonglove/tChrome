{
  "type": "function",
  "function": {
    "name": "page_storage",
    "description": "读或写页内 localStorage。\n参数：可选 action、key（键名）、value（值）、tab（目标标签编号）。\n返回：ok、storage（存储内容）。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
