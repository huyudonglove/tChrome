{
  "type": "function",
  "function": {
    "name": "capture_rect",
    "description": "按 CSS 像素矩形裁剪页面截图。必填 tabId。返回 ok、mode、image。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号（必填；从 tabs.current 等返回取得，不随前台切换）。"
        },
        "x": {
          "type": "number",
          "description": "左上角 x（CSS 像素）"
        },
        "y": {
          "type": "number",
          "description": "左上角 y（CSS 像素）"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "裁剪宽度（>0）"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "裁剪高度（>0）"
        }
      },
      "required": [
        "reason",
        "tabId",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    }
  }
}
