{
  "type": "function",
  "function": {
    "name": "local.process_status",
    "description": "查询本会话后台进程。返回 status、exitCode、signal、stdout/stderr及截断标志。每次返回累计输出的末尾65536字符，不是新增增量。\n本机操作，affectsPage=false；这不表示没有文件或系统副作用。",
    "parameters": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "本次操作的目的"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "processId",
        "reason",
        "affectsPage"
      ],
      "additionalProperties": false
    }
  }
}
