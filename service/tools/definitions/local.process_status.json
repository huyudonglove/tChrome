{
  "type": "function",
  "function": {
    "name": "local.process_status",
    "description": "查询本会话后台进程。返回 status、exitCode、signal、完整累计 stdout/stderr，以及持久化原文路径 stdoutPath/stderrPath；不是新增增量。",
    "parameters": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "本次操作的目的"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "processId",
        "reason",
        "affectsPage"
      ],
      "additionalProperties": false
    }
  }
}
