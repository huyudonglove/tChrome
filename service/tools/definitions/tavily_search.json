{
  "type": "function",
  "function": {
    "name": "tavily_search",
    "description": "通过 Tavily 高级搜索获取公开网页及相关内容。\nquery 去除首尾空白后搜索；maxResults 默认 5。固定使用 advanced 搜索。\n返回：ok、query、searchDepth、results（title、url、content、score）和 urls，最多 maxResults 条；每项 content 最多 4000 字符，超限标注 truncated。失败返回 faultCode、error。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "query",
        "reason",
        "affectsPage"
      ],
      "additionalProperties": false
    }
  }
}
