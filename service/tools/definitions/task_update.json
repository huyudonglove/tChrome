{
  "type": "function",
  "function": {
    "name": "task_update",
    "description": "按显式 taskId 和步骤 id 更新任务。items 至少一项，支持 status、text、expectedEffect、verification、blockedReason、outcome。同一任务至多一个 doing，done 不可回退。验证通过后标记 done，失败时保持 doing 并记录 blockedReason。未完成时返回 taskRef 指针；所有步骤 done 时立即完成任务，完整最终 task 返回到本次调用结果，并移出未完成 tasks。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "taskId": {
          "type": "string",
          "description": "需要更新的任务 ID"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "稳定 taskItemId"
              },
              "status": {
                "type": "string",
                "enum": [
                  "todo",
                  "doing",
                  "done"
                ]
              },
              "text": {
                "type": "string"
              },
              "expectedEffect": {
                "type": "string"
              },
              "verification": {
                "type": "string"
              },
              "blockedReason": {
                "type": "string",
                "description": "doing 时记录失败证据或阻塞原因"
              },
              "outcome": {
                "type": "string",
                "description": "步骤完成时的交付成果、排查结论或因果事实"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reason",
        "items",
        "taskId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
