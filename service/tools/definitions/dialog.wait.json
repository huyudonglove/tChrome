{
  "type": "function",
  "function": {
    "name": "dialog.wait",
    "description": "等待原生 JavaScript 弹窗（alert/confirm/prompt）出现。出现后用 handle_dialog 处理。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "tabId": {
          "type": "integer"
        },
        "timeoutMs": {
          "type": "integer",
          "description": "超时毫秒，默认 5000，上限 12000"
        }
      },
      "required": [
        "reason",
        "tabId"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
