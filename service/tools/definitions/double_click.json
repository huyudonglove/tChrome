{
  "type": "function",
  "function": {
    "name": "double_click",
    "description": "双击页面上匹配 text 的元素。\n参数：可选 ref、text；必填 tabId（目标标签编号）。\n返回：ok、clicked（点击结果）。\nref：snapshot_page 或 find_on_page 返回的元素 ref；有 ref 时优先使用。\ntext：没有 ref 时按控件可见文字、value 或 aria-label 定位。\n必须提供 ref 或非空 text。ref 无效时明确失败，不回退按文字操作。text 匹配多个控件时返回歧义，请先查找并提供 ref；不可混用 page.* 的 id。",
    "parameters": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "参数含义见工具说明。",
          "pattern": "^el_[0-9]{2,}$",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "没有 ref 时按控件可见文字、value 或 aria-label 定位",
          "minLength": 1
        },
        "tabId": {
          "type": "integer",
          "description": "目标标签编号；从 #openTabs 或工具返回取得。必须显式指定，不随前台切换；目标失效时返回错误。"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "tabId"
      ],
      "anyOf": [
        {
          "required": [
            "ref"
          ],
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "description": "参数含义见工具说明。",
              "pattern": "^el_[0-9]{2,}$",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "text"
          ],
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "没有 ref 时按控件可见文字、value 或 aria-label 定位",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
