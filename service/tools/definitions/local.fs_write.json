{
  "type": "function",
  "function": {
    "name": "local.fs_write",
    "description": "写入UTF-8文本文件，默认替换整个文件内容，append=true则追加。父目录必须已存在。返回写入字节数。",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "绝对路径"
        },
        "content": {
          "type": "string"
        },
        "append": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "path",
        "content",
        "reason",
        "affectsPage"
      ],
      "additionalProperties": false
    }
  }
}
