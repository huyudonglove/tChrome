{
  "type": "function",
  "function": {
    "name": "task.complete",
    "description": "将当前 Task 标为 completed。\n前置：全部 items 为 done；仍有 todo/doing 会失败。可选 taskId（默认活动 Task）。\n返回：ok、taskId。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
