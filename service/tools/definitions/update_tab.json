{
  "type": "function",
  "function": {
    "name": "update_tab",
    "description": "固定或静音标签。\n参数：可选 tab（目标标签编号）、pinned（是否固定）、muted（是否静音）。\n返回：ok（是否成功）。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
