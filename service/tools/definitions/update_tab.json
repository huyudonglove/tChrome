{
  "type": "function",
  "function": {
    "name": "update_tab",
    "description": "固定或静音标签。\n参数：必填 tabId（目标标签编号）；pinned（是否固定）和 muted（是否静音）至少提供一个，未提供的状态保持原状。\n返回：ok。",
    "parameters": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "integer",
          "description": "目标标签编号；从 <openTabs> 或工具返回取得。必须显式指定，不随前台切换；目标失效时返回错误。"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean",
          "description": "是否固定标签：true 固定，false 取消固定；省略时保持原状。"
        },
        "muted": {
          "type": "boolean",
          "description": "是否静音标签：true 静音，false 取消静音；省略时保持原状。"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "tabId"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "pinned"
          ],
          "type": "object",
          "properties": {
            "pinned": {
              "type": "boolean",
              "description": "是否固定标签：true 固定，false 取消固定；省略时保持原状。"
            }
          }
        },
        {
          "required": [
            "muted"
          ],
          "type": "object",
          "properties": {
            "muted": {
              "type": "boolean",
              "description": "是否静音标签：true 静音，false 取消静音；省略时保持原状。"
            }
          }
        }
      ]
    }
  }
}
