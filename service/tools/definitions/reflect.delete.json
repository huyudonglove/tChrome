{
  "type": "function",
  "function": {
    "name": "reflect.delete",
    "description": "按 id 删除当前 turn 的一条反思记录（rf_ 编号，来自 <reflection>）。\n参数：必填 id。\n执行调度：serial（Runtime 固定，不必返回）。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^rf_[0-9]{2,}$",
          "description": "要删除的反思编号"
        }
      },
      "required": [
        "reason",
        "id"
      ],
      "additionalProperties": false
    }
  },
  "execution": "serial"
}
