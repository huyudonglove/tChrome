{
  "type": "function",
  "function": {
    "name": "local.diagnose",
    "description": "对指定工程或文件执行结构化类型诊断（typecheck）或测试诊断（test），直接解析并返回精炼结构化的错误清单（文件、行号、列号、错误码、错误信息），免除大日志往返摩擦。",
    "parameters": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "工程根目录绝对路径"
        },
        "kind": {
          "type": "string",
          "enum": ["typecheck", "test"],
          "description": "诊断类型：typecheck 执行类型检查；test 执行单测"
        },
        "target": {
          "type": "string",
          "description": "可选目标相对路径或绝对路径（如具体测试文件、tsconfig.json 或目录）"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "description": "可选超时时间（毫秒），默认 60000"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "cwd",
        "kind",
        "reason",
        "affectsPage"
      ],
      "additionalProperties": false
    }
  }
}
