      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        },
        "tab": {
          "type": "number"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "id"
      ]
    }
  }
}
