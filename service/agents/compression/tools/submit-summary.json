{
  "type": "function",
  "function": {
    "name": "submitSummary",
    "description": "提交本次压缩结果。tag 是便于语义检索的主题，summary 保留关键事实、约束、变化和待办。调用此工具完成本次压缩。",
    "parameters": {
      "type": "object",
      "properties": {
        "tag": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" }
      },
      "required": ["tag", "summary"],
      "additionalProperties": false
    }
  }
}
