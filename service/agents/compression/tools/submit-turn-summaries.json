{
  "type": "function",
  "function": {
    "name": "submitTurnSummaries",
    "description": "提交本批次逐轮摘要，turnId 必须与输入逐一对应。每轮独立记录当时要求、行动和结果，不生成当前待办。",
    "parameters": {
      "type": "object",
      "properties": {
        "summaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "turnId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "userRequest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1600,
                "pattern": "\\S"
              },
              "actions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2400,
                "pattern": "\\S"
              }
            },
            "required": [
              "turnId",
              "tag",
              "userRequest",
              "actions",
              "result"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "summaries"
      ],
      "additionalProperties": false
    }
  }
}
