{
  "type": "function",
  "function": {
    "name": "submitTurnSummaries",
    "description": "提交本批次逐轮摘要。每个输入 turnId 对应一项摘要，逐轮记录用户要求、实际行动和结果；所有摘要字段均为非空字符串。",
    "parameters": {
      "type": "object",
      "properties": {
        "summaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "turnId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "所属轮次的 ID 字符串，原样复制输入中的 turnId。"
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "用于检索的主题字符串，概括关键对象、事件或约束。"
              },
              "userRequest": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "用户实际要求与重要条件的文字摘要；输入未提供用户要求时，用文字明确说明。"
              },
              "actions": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "实际执行的关键步骤、修正和重要失败，整理为一段字符串。多个步骤用文字串联，区分计划与已执行操作。"
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "本轮或分段的已验证结果、最终回复、错误或等待状态的文字摘要。保留回复与执行证据的差异；查询结论注明来自历史证据。"
              }
            },
            "required": [
              "turnId",
              "tag",
              "userRequest",
              "actions",
              "result"
            ],
            "additionalProperties": false
          },
          "description": "本批次逐轮摘要数组，每个输入 turnId 恰好对应一个对象。"
        }
      },
      "required": [
        "summaries"
      ],
      "additionalProperties": false
    }
  }
}
