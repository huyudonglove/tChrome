{
  "version": 1,
  "description": "Context module registry: one place for order, XML files, agent consumers, and compression archive fields.",
  "modules": [
    {
      "id": "overview",
      "role": "system",
      "order": 1,
      "file": "system/overview.md",
      "consumers": [
        "main"
      ],
      "description": "Agent Loop, Context Assembly"
    },
    {
      "id": "identity",
      "role": "system",
      "order": 2,
      "file": "system/identity.md",
      "consumers": [
        "main"
      ],
      "description": "Identity, Collaboration, Language"
    },
    {
      "id": "environment",
      "role": "system",
      "order": 3,
      "file": "system/environment.md",
      "consumers": [
        "main"
      ],
      "description": "Environment, Tool Discovery"
    },
    {
      "id": "runtimeProtocol",
      "role": "system",
      "order": 4,
      "file": "system/runtimeProtocol.md",
      "consumers": [
        "main"
      ],
      "description": "Context Assembly, Compression, Images",
      "inject": [
        "compressAt",
        "hardLimitChars",
        "summaryFoldMin",
        "inlineChars",
        "imageInlineBytes",
        "readOnlyPrompt",
        "readOnlySecond",
        "readOnlyHard"
      ]
    },
    {
      "id": "recordIdentity",
      "role": "system",
      "order": 5,
      "file": "system/recordIdentity.md",
      "consumers": [
        "main"
      ],
      "description": "ID Rules, Record References"
    },
    {
      "id": "execution",
      "role": "system",
      "order": 6,
      "file": "system/execution.md",
      "consumers": [
        "main"
      ],
      "description": "Task Execution, Verification, Recovery"
    },
    {
      "id": "toolProtocol",
      "role": "system",
      "order": 7,
      "file": "system/toolProtocol.md",
      "consumers": [
        "main"
      ],
      "description": "Tool Calls, Parameters, Execution Order"
    },
    {
      "id": "boundaries",
      "role": "system",
      "order": 8,
      "file": "system/boundaries.md",
      "consumers": [
        "main"
      ],
      "description": "Authorization, Reference Material"
    },
    {
      "id": "output",
      "role": "system",
      "order": 9,
      "file": "system/output.md",
      "consumers": [
        "main"
      ],
      "description": "Responses, Action Reasons, Final Answer"
    },
    {
      "id": "baseTools",
      "role": "system",
      "order": 10,
      "file": "system/baseTools.md",
      "consumers": [
        "main"
      ],
      "description": "Resident Tools, Task Management"
    },
    {
      "id": "systemSkill",
      "role": "system",
      "order": 11,
      "file": "system/systemSkill.md",
      "consumers": [
        "main"
      ],
      "inject": [
        "skillCatalogLimit"
      ],
      "description": "System Skill Index"
    },
    {
      "id": "skill",
      "role": "user",
      "order": 1,
      "file": "user/skill.md",
      "consumers": [
        "main"
      ],
      "description": "Skills"
    },
    {
      "id": "projectMemory",
      "role": "user",
      "order": 2,
      "file": "user/projectMemory.md",
      "consumers": [
        "main"
      ],
      "description": "Long-Term Memory"
    },
    {
      "id": "tools",
      "role": "user",
      "order": 3,
      "file": "user/tools.md",
      "consumers": [
        "main"
      ],
      "description": "Loaded Tools"
    },
    {
      "id": "conversation",
      "role": "user",
      "order": 4,
      "file": "user/conversation.md",
      "consumers": [
        "main"
      ],
      "description": "Conversation timeline by loop"
    },
    {
      "id": "contextUsage",
      "role": "user",
      "order": 5,
      "file": "user/contextUsage.md",
      "consumers": [
        "main"
      ],
      "description": "Current context character usage"
    },
    {
      "id": "loops",
      "role": "archive",
      "order": 1,
      "file": null,
      "consumers": [
        "compression"
      ],
      "archiveField": "loops",
      "description": "Ordered model interactions with runtime inputs and Helm responses"
    }
  ]
}
