{
  "version": 1,
  "description": "Context module registry: one place for order, XML files, agent consumers, and compression archive fields.",
  "modules": [
    { "id": "overview", "role": "system", "order": 1, "file": "system/overview.md", "consumers": ["main"], "description": "Agent Loop, Context Assembly" },
    { "id": "identity", "role": "system", "order": 2, "file": "system/identity.md", "consumers": ["main"], "description": "Identity, Collaboration, Language" },
    { "id": "environment", "role": "system", "order": 3, "file": "system/environment.md", "consumers": ["main"], "description": "Environment, Tool Discovery" },
    { "id": "runtime", "role": "system", "order": 4, "file": "system/runtime.md", "consumers": ["main"], "description": "Context Assembly, Compression, Images", "inject": ["compressAt", "externalizeAt", "summaryRecompressMin", "keepBatches", "inlineChars", "previewChars", "summaryChars", "lineWidth", "searchContextChars", "imageInlineBytes"] },
    { "id": "recordIdentity", "role": "system", "order": 5, "file": "system/recordIdentity.md", "consumers": ["main"], "description": "ID Rules, Record References" },
    { "id": "execution", "role": "system", "order": 6, "file": "system/execution.md", "consumers": ["main"], "description": "Task Execution, Verification, Recovery" },
    { "id": "toolProtocol", "role": "system", "order": 7, "file": "system/toolProtocol.md", "consumers": ["main"], "description": "Tool Calls, Parameters, Execution Order" },
    { "id": "boundaries", "role": "system", "order": 8, "file": "system/boundaries.md", "consumers": ["main"], "description": "Authorization, Reference Material" },
    { "id": "output", "role": "system", "order": 9, "file": "system/output.md", "consumers": ["main"], "description": "Responses, Action Reasons, Final Answer" },
    { "id": "baseTools", "role": "system", "order": 10, "file": "system/baseTools.md", "consumers": ["main"], "description": "Resident Tools, Task Management" },
    { "id": "systemSkill", "role": "system", "order": 11, "file": "system/systemSkill.md", "consumers": ["main"], "description": "System Skill Index" },

    { "id": "skill", "role": "user", "order": 1, "file": "user/skill.md", "consumers": ["main"], "compress": false, "description": "Skills" },
    { "id": "projectMemory", "role": "user", "order": 2, "file": "user/projectMemory.md", "consumers": ["main"], "compress": false, "description": "Long-Term Memory" },
    { "id": "tools", "role": "user", "order": 3, "file": "user/tools.md", "consumers": ["main"], "compress": false, "description": "Loaded Tools" },
    { "id": "conversation", "role": "user", "order": 4, "file": "user/conversation.md", "consumers": ["main"], "compress": false, "description": "Conversation Timeline By Turn" },

    { "id": "userInput", "role": "archive", "order": 1, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "userInput", "coverage": "turn", "description": "Turn user input" },
    { "id": "goalChanges", "role": "archive", "order": 2, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "goalChanges", "coverage": "sourceCallId", "description": "Goal changes in the turn" },
    { "id": "toolIO", "role": "archive", "order": 3, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "toolIO", "coverage": "batch", "description": "Tool IO" },
    { "id": "observations", "role": "archive", "order": 4, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "observations", "coverage": "callId", "description": "Observations" },
    { "id": "memoryWrites", "role": "archive", "order": 5, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "memoryWrites", "coverage": "sourceCallId", "description": "Conversation memory writes" },
    { "id": "reflection", "role": "archive", "order": 6, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "reflection", "coverage": "turn", "description": "Turn reflection" },
    { "id": "queryHistory", "role": "archive", "order": 8, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "queryHistory", "coverage": "queryId", "description": "Query History" },
    { "id": "turnOutput", "role": "archive", "order": 9, "file": null, "consumers": ["compression"], "compress": true, "archiveField": "stopReason", "coverage": "settledTurnOnly", "description": "Turn closing output", "inputSemantics": "对象或 null。`{kind:\"reply\", text}` 为最终回复正文；`{kind:\"ask\", question}` / `{kind:\"error\", faultCode, causeCode?, toolName?, detail?}` / `{kind:\"tool\", name, callId}`。null 表示暂无收尾。" }
  ]
}
