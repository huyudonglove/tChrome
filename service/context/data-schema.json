{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User 模块数据契约",
  "description": "模型窗口各插槽的逻辑值。skill / conversation / tools 为文本，其余槽取 JSON 解析后的值；不含 # 标签。conversation 为按 turnId 嵌套的 XML 时间线正文。ID 前缀与分配范围由 service/identity/catalog.json 定义。发送前受 250000 字符内联预算约束，除 tools 和 skill 外的数据模块可用本地文件引用替代；skill 始终保留完整文本，不参与压缩或裁剪。",
  "type": "object",
  "properties": {
    "skill": {
      "type": "string"
    },
    "projectMemory": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/memory"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "tools": {
      "type": "string"
    },
    "conversation": {
      "type": "string"
    }
  },
  "required": [
    "skill",
    "projectMemory",
    "tools",
    "conversation"
  ],
  "additionalProperties": false,
  "$defs": {
    "turnId": {
      "$ref": "tchrome:identity#/$defs/turn"
    },
    "memoryId": {
      "$ref": "tchrome:identity#/$defs/projectMemory"
    },
    "callId": {
      "$ref": "tchrome:identity#/$defs/call"
    },
    "memory": {
      "type": "object",
      "properties": {
        "memoryId": {
          "$ref": "#/$defs/memoryId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "sourceCallId": {
          "$ref": "#/$defs/callId"
        },
        "sourceConversationId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["memoryId", "turnId", "text"],
      "additionalProperties": true
    },
    "contextFileReference": {
      "type": "object",
      "properties": {
        "contextFile": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "chars": {
              "type": "integer",
              "minimum": 0
            },
            "format": {
              "type": "string",
              "enum": ["json", "text"]
            }
          },
          "required": ["path", "chars", "format"],
          "additionalProperties": false
        }
      },
      "required": ["contextFile"],
      "additionalProperties": false
    }
  }
}
