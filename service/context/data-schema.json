{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User 模块数据契约",
  "description": "模型窗口各插槽的逻辑值。文本槽保持字符串，其余槽取 JSON 解析后的值；不含 # 标签。ID 前缀与分配范围由 service/identity/catalog.json 定义。 发送前受 250000 字符内联预算约束，除 tools 和 skill 外的数据模块可用本地文件引用替代；skill 始终保留完整文本，不参与压缩或裁剪。",
  "type": "object",
  "properties": {
    "skill": {
      "type": "string"
    },
    "userInput": {
      "anyOf": [
        {
          "$ref": "#/$defs/input"
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "conversationHistorySummary": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/summary"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "userInputHistory": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/input"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "goal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "currentGoalId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/goalId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "goals": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/goal"
              }
            }
          },
          "required": [
            "currentGoalId",
            "goals"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "goalHistory": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/goal"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "openTabs": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "windowId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "focused": {
                    "type": "boolean"
                  },
                  "tabs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "tabId": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "url": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "active": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "tabId",
                        "url",
                        "title",
                        "active"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "windowId",
                  "focused",
                  "tabs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "ok",
            "windows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "pageObservedHistory": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/pageObservation"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "projectMemory": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/projectMemory"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "conversationMemory": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/conversationMemory"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "toolIO": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/tool"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "lastAction": {
      "anyOf": [
        {
          "$ref": "#/$defs/lastAction"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "checklist": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "todo",
                      "doing",
                      "done"
                    ]
                  }
                },
                "required": [
                  "text",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "updatedAt": {
              "type": "string"
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "queryHistory": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/query"
              },
              {
                "$ref": "#/$defs/contextFileReference"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "currentQuery": {
      "anyOf": [
        {
          "anyOf": [
            {
              "$ref": "#/$defs/query"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "$ref": "#/$defs/contextFileReference"
        }
      ]
    },
    "tools": {
      "type": "string"
    }
  },
  "required": [
    "skill",
    "userInput",
    "conversationHistorySummary",
    "userInputHistory",
    "goal",
    "goalHistory",
    "openTabs",
    "pageObservedHistory",
    "projectMemory",
    "conversationMemory",
    "notes",
    "toolIO",
    "lastAction",
    "checklist",
    "queryHistory",
    "currentQuery",
    "tools"
  ],
  "additionalProperties": false,
  "$defs": {
    "conversationId": {
      "$ref": "tchrome:identity#/$defs/conversation"
    },
    "turnId": {
      "$ref": "tchrome:identity#/$defs/turn"
    },
    "inputId": {
      "$ref": "tchrome:identity#/$defs/input"
    },
    "goalId": {
      "anyOf": [
        {
          "$ref": "tchrome:identity#/$defs/goal"
        },
        {
          "$ref": "tchrome:identity#/$defs/subgoal"
        }
      ]
    },
    "pageId": {
      "$ref": "tchrome:identity#/$defs/page"
    },
    "callId": {
      "$ref": "tchrome:identity#/$defs/call"
    },
    "batchId": {
      "$ref": "tchrome:identity#/$defs/batch"
    },
    "conversationMemoryId": {
      "$ref": "tchrome:identity#/$defs/conversationMemory"
    },
    "projectMemoryId": {
      "$ref": "tchrome:identity#/$defs/projectMemory"
    },
    "sumId": {
      "$ref": "tchrome:identity#/$defs/sum"
    },
    "queryId": {
      "$ref": "tchrome:identity#/$defs/query"
    },
    "input": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/inputId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "userInput": {
          "type": "string"
        },
        "submittedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "turnId",
        "userInput"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/goalId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "sourceCallId": {
          "$ref": "#/$defs/callId"
        },
        "goal": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "tchrome:identity#/$defs/goal"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "active",
            "completed",
            "cancelled"
          ]
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "turnId",
        "goal",
        "parentId",
        "status"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/pageId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "callId": {
          "$ref": "#/$defs/callId"
        },
        "batchId": {
          "$ref": "#/$defs/batchId"
        },
        "tabId": {
          "type": "integer"
        },
        "type": {
          "type": "string"
        },
        "result": {},
        "observedAt": {
          "type": "string"
        }
      },
      "required": [
        "tabId",
        "type",
        "result"
      ],
      "additionalProperties": false
    },
    "lastAction": {
      "type": "object",
      "properties": {
        "batchId": {
          "$ref": "#/$defs/batchId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "callId": {
                "$ref": "#/$defs/callId"
              },
              "name": {
                "type": "string"
              },
              "pageObservationId": {
                "$ref": "#/$defs/pageId"
              }
            },
            "required": [
              "callId",
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "batchId",
        "turnId",
        "calls"
      ],
      "additionalProperties": false
    },
    "pageObservation": {
      "allOf": [
        {
          "$ref": "#/$defs/page"
        },
        {
          "required": [
            "id",
            "turnId",
            "callId"
          ]
        }
      ]
    },
    "memory": {
      "type": "object",
      "properties": {
        "memoryId": {
          "anyOf": [
            {
              "$ref": "#/$defs/conversationMemoryId"
            },
            {
              "$ref": "#/$defs/projectMemoryId"
            }
          ]
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "sourceCallId": {
          "$ref": "#/$defs/callId"
        },
        "sourceConversationId": {
          "$ref": "#/$defs/conversationId"
        },
        "text": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "conversation",
            "project"
          ]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "memoryId",
        "turnId",
        "text"
      ],
      "additionalProperties": false
    },
    "projectMemory": {
      "allOf": [
        {
          "$ref": "#/$defs/memory"
        },
        {
          "properties": {
            "memoryId": {
              "$ref": "#/$defs/projectMemoryId"
            }
          }
        }
      ]
    },
    "conversationMemory": {
      "allOf": [
        {
          "$ref": "#/$defs/memory"
        },
        {
          "properties": {
            "memoryId": {
              "$ref": "#/$defs/conversationMemoryId"
            }
          }
        }
      ]
    },
    "toolReturn": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stage": {
              "enum": [
                "complete",
                "truncated"
              ]
            },
            "result": {}
          },
          "required": [
            "stage",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stage": {
              "enum": [
                "complete",
                "truncated"
              ]
            },
            "totalChars": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "stage",
            "totalChars",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tool": {
      "type": "object",
      "properties": {
        "callId": {
          "$ref": "#/$defs/callId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "batchId": {
          "$ref": "#/$defs/batchId"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "return": {
          "$ref": "#/$defs/toolReturn"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "callId",
        "turnId",
        "name",
        "arguments",
        "return"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "sumId": {
          "$ref": "#/$defs/sumId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "tag": {
          "type": "string"
        },
        "userRequest": {
          "type": "string"
        },
        "actions": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "module": {
          "const": "conversationHistory"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "sumId",
        "turnId",
        "tag",
        "userRequest",
        "actions",
        "result"
      ],
      "additionalProperties": false
    },
    "queryRecord": {
      "anyOf": [
        {
          "$ref": "#/$defs/input"
        },
        {
          "$ref": "#/$defs/goal"
        },
        {
          "$ref": "#/$defs/pageObservation"
        },
        {
          "$ref": "#/$defs/memory"
        },
        {
          "$ref": "#/$defs/tool"
        },
        {
          "$ref": "#/$defs/summary"
        },
        {
          "$ref": "#/$defs/query"
        },
        {
          "$ref": "#/$defs/output"
        },
        {
          "$ref": "#/$defs/fragment"
        }
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "queryId": {
          "$ref": "#/$defs/queryId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "sumId": {
          "$ref": "#/$defs/sumId"
        },
        "module": {
          "enum": [
            "userInput",
            "goalChanges",
            "toolIO",
            "pageObservations",
            "memoryWrites",
            "output",
            "queryHistory",
            "summaries"
          ]
        },
        "intent": {
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "not_found",
            "error"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queryRecord"
          }
        },
        "sourceCallId": {
          "$ref": "#/$defs/callId"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "queryId",
        "turnId",
        "sumId",
        "module",
        "intent",
        "status",
        "records"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "kind": {
          "enum": [
            "reply",
            "ask",
            "error",
            "tool"
          ]
        },
        "text": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "faultCode": {
          "type": "string"
        },
        "causeCode": {
          "type": "string"
        },
        "toolName": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "callId": {
          "$ref": "#/$defs/callId"
        }
      },
      "required": [
        "turnId",
        "kind"
      ],
      "additionalProperties": false
    },
    "fragment": {
      "type": "object",
      "properties": {
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "id": {
          "type": "string"
        },
        "callId": {
          "$ref": "#/$defs/callId"
        },
        "memoryId": {
          "anyOf": [
            {
              "$ref": "#/$defs/conversationMemoryId"
            },
            {
              "$ref": "#/$defs/projectMemoryId"
            }
          ]
        },
        "queryId": {
          "$ref": "#/$defs/queryId"
        },
        "sumId": {
          "$ref": "#/$defs/sumId"
        },
        "batchId": {
          "$ref": "#/$defs/batchId"
        },
        "sourceCallId": {
          "$ref": "#/$defs/callId"
        },
        "fragment": {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "totalChars": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "offset",
            "totalChars",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "turnId",
        "fragment"
      ],
      "additionalProperties": false
    },
    "contextFileReference": {
      "type": "object",
      "properties": {
        "contextFile": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "chars": {
              "type": "integer",
              "minimum": 0
            },
            "format": {
              "enum": [
                "json",
                "text"
              ]
            }
          },
          "required": [
            "path",
            "chars",
            "format"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contextFile"
      ],
      "additionalProperties": false
    }
  }
}
