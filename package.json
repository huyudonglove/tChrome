{
  "name": "tchrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "service": "bun run service/server.ts",
    "service:proxy": "TCHROME_PROXY_MODE=proxy bun run service/server.ts",
    "service:direct": "TCHROME_PROXY_MODE=direct bun run service/server.ts",
    "build": "bun run scripts/build-extension.ts",
    "test": "bun test",
    "check": "bun test && bun run scripts/build-extension.ts"
  },
  "dependencies": {
    "@tavily/core": "^0.7.11",
    "ajv": "^8.20.0",
    "marked": "^18.0.13",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.1",
    "@types/chrome": "^0.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0"
  }
}
