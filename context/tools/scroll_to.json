{
  "type": "function",
  "function": {
    "name": "scroll_to",
    "description": "把匹配 text 的元素滚进可视区。\n参数：可选 text（文本）、tab（目标标签编号）。\n返回：ok（是否成功）。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "description": "面向用户的行动理由，表达要求见 #output。"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
