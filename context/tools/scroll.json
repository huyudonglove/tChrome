{
  "type": "function",
  "function": {
    "name": "scroll",
    "description": "滚动当前页。\n参数：可选 amount（滚动像素数，负数向上）、tab（目标标签编号）。\n返回：ok（是否成功）。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "description": "像素，负数向上"
        },
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "description": "面向用户的行动理由，表达要求见 #output。"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
