{
  "type": "function",
  "function": {
    "name": "account_vault",
    "description": "本地账号库。action=list 列站点账号；action=get 按 id 或 site+username 取完整凭据；action=save 保存或更新 site/username/password/label/note；action=delete 按 id 删除。返回：ok、account 或 items affectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "save",
            "delete"
          ]
        },
        "id": {
          "type": "string"
        },
        "site": {
          "type": "string",
          "description": "站点域名或 URL"
        },
        "username": {
          "type": "string",
          "description": "邮箱、用户名或手机号"
        },
        "password": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "reveal": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
