{
  "type": "function",
  "function": {
    "name": "update_window",
    "description": "改变窗口状态。\n参数：可选 state（窗口状态）。\n返回：ok（是否成功）。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "description": "面向用户的行动理由，表达要求见 #output。"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
