{
  "type": "function",
  "function": {
    "name": "press",
    "description": "对当前焦点元素按下一个键盘键。\n参数：key（键名），可选 tab（目标标签编号）。\n返回：ok（是否成功）；没有焦点失败。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "key"
      ]
    }
  }
}
