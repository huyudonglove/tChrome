{
  "type": "function",
  "function": {
    "name": "handle_dialog",
    "description": "处理页面对话框（需要在页面加载前设置监听）。\n返回：ok=false、error（提示需要提前设置）。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "description": "面向用户的行动理由，表达要求见 #output。"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
