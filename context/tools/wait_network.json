{
  "type": "function",
  "function": {
    "name": "wait_network",
    "description": "等到页面接口和资源安静后再读页。入参：可选 ms（安静多久）、tab。返回：ok、requests、sample、title、url、text；超时 ok=false affectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "ms": {
          "type": "number",
          "description": "连续安静多久算就绪"
        },
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
