{
  "type": "function",
  "function": {
    "name": "execute_javascript",
    "description": "在当前页执行一段表达式。\n参数：code（页内执行的表达式），可选 tab（目标标签编号）。\n返回：ok（是否成功）、value（当前值）。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "页内执行的 脚本表达式"
        },
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage",
        "code"
      ]
    }
  }
}
