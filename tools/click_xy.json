{
  "type": "function",
  "function": {
    "name": "click_xy",
    "description": "按坐标点击。\n参数：point=[x,y]，也可传 x、y；可选 tab（目标标签编号）。\n返回：ok（是否成功）、point。滑块不要点，用 calibrate_drag。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "point": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "视口坐标 [x,y]"
        },
        "x": {
          "type": "number",
          "description": "没有 point 时的横坐标"
        },
        "y": {
          "type": "number",
          "description": "没有 point 时的纵坐标"
        },
        "tab": {
          "type": "number"
        },
        "tabId": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
