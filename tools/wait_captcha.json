{
  "type": "function",
  "function": {
    "name": "wait_captcha",
    "description": "等到 Turnstile 或同类验证出现。\n参数：可选 tab（目标标签编号）、timeoutMs（超时毫秒数）。\n返回：ok（是否成功）、present（是否出现）、type（类型）、ready。\naffectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
