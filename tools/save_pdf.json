{
  "type": "function",
  "function": {
    "name": "save_pdf",
    "description": "把当前页存成 PDF。\n参数：可选 tab（目标标签编号）。\n返回：ok（是否成功） 或 error（失败原因）。\naffectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
