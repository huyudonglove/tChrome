{
  "type": "function",
  "function": {
    "name": "reload",
    "description": "刷新当前页。\n参数：可选 tab（目标标签编号）。\n返回：ok（是否成功）、title（页面标题）、url（页面地址）、text（返回文本）。\naffectsPage=true。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ],
      "additionalProperties": true
    }
  }
}
