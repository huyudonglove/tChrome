{
  "type": "function",
  "function": {
    "name": "ping_url",
    "description": "探测一个网址是否可达。\n参数：可选 url（网址）。\n返回：ok（是否成功）、reachable（是否可达）、status（响应状态码）、ms（耗时毫秒数）。\naffectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
