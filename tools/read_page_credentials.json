{
  "type": "function",
  "function": {
    "name": "read_page_credentials",
    "description": "读当前页可见的账号相关字段。\n参数：可选 tab（目标标签编号）。\n返回：ok（是否成功）、fields（账号相关字段）。\naffectsPage=false。",
