{
  "type": "function",
  "function": {
    "name": "probe_ssl",
    "description": "查看证书是否有效。\n参数：host（域名） 或 url（网址），可选 port（端口）。\n返回：ok（是否成功）、valid（证书是否有效）、issuer、validTo。\naffectsPage=false。",
    "parameters": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "port": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "affectsPage": {
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "affectsPage"
      ]
    }
  }
}
