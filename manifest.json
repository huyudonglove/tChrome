{
  "manifest_version": 3,
  "name": "tChrome",
  "description": "Chrome extension.",
  "version": "0.1.0",
  "minimum_chrome_version": "135",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "cookies",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-console.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open tChrome"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
