{
  "manifest_version": 3,
  "name": "tChrome",
  "description": "Chrome extension.",
  "version": "0.1.0",
  "minimum_chrome_version": "135",
  "permissions": ["sidePanel", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1:18788/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open tChrome"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
