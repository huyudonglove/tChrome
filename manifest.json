{
  "manifest_version": 3,
  "name": "tChrome",
  "description": "Chrome extension.",
  "version": "0.1.0",
  "minimum_chrome_version": "135",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "activeTab",
    "cookies",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open tChrome",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
